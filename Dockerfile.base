# =============================================================================
# BASE IMAGES FOR ICP DASHBOARDS UI
# =============================================================================
# Build commands:
#   docker build -f Dockerfile.base --target builder-base -t scr.saal.ai/icp-dashboards-builder-base:latest .
#   docker build -f Dockerfile.base --target runtime-base -t scr.saal.ai/icp-dashboards-runtime-base:latest .
# =============================================================================

# -----------------------------------------------------------------------------
# BUILDER BASE - Dependencies & build tools
# -----------------------------------------------------------------------------
FROM node:22-alpine AS builder-base

# Update and upgrade packages to fix CVEs
RUN apk update && apk upgrade --no-cache

# Fix glob CVE in npm's bundled dependency
# npm@10.9.4 (bundled with Node 22) includes glob@10.4.5 which is vulnerable (CVE-2025-64756)
# Upgrade npm to 11.6.4 which includes patched glob@13.0.0 (fixes CVE-2025-64756)
RUN npm install -g npm@11.6.4

# Set working directory
WORKDIR /app

# Copy package files and install all node dependencies
COPY package.json yarn.lock* .npmrc* ./
RUN yarn install --frozen-lockfile

# -----------------------------------------------------------------------------
# RUNTIME BASE - For hosting the application
# -----------------------------------------------------------------------------
FROM node:22-alpine AS runtime-base

# Update and upgrade all packages to fix CVEs (busybox, busybox-binsh, ssl_client)
# This ensures we get the latest patched versions
RUN apk update && apk upgrade --no-cache

# Fix glob CVE in npm's bundled dependency
# npm@10.9.4 (bundled with Node 22) includes glob@10.4.5 which is vulnerable (CVE-2025-64756)
# Upgrade npm to 11.6.4 which includes patched glob@13.0.0 (fixes CVE-2025-64756)
RUN npm install -g npm@11.6.4

# Install only essential packages for headless Chromium
# Removed: X11 libraries (libx11, libxi, libxrandr, libxrender, mesa-gl) - not needed for headless
# Removed: udev - not needed in containers
RUN apk add --no-cache \
    ca-certificates \
    chromium \
    curl \
    freetype \
    harfbuzz \
    libjpeg-turbo \
    nss \
    ttf-freefont \
    ttf-dejavu \
    && mkdir -p /etc/chromium.d

WORKDIR /app

ENV PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=true \
    PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium-browser